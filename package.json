{
  "name": "windows-crasher",
  "version": "2.6.0",
  "description": "Videojuego incremental y de benchmarking de hardware con Watchdog de seguridad",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:portable": "electron-builder --win portable",
    "pack:web": "powershell -NoProfile -Command \"if (-not (Test-Path dist)) { New-Item -ItemType Directory -Path dist }; Compress-Archive -Path 'src/renderer/*' -DestinationPath 'dist/Windows-Crasher-v2.6.0-HTML5-Web.zip' -Force\"",
    "cap:sync": "cap sync android",
    "cap:open": "cap open android"
  },
  "keywords": [
    "benchmark",
    "game",
    "stress-test",
    "electron",
    "hardware-monitor"
  ],
  "author": "Daniel Valimaña (DanielFbr1)",
  "license": "MIT",
  "devDependencies": {
    "@capacitor/android": "^8.5.1",
    "@capacitor/cli": "^8.5.1",
    "@capacitor/core": "^8.5.1",
    "electron": "^34.2.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.danielfbr.windowscrasher",
    "productName": "Windows Crasher",
    "copyright": "Copyright © 2026 DanielFbr1",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Windows Crasher"
    },
    "portable": {
      "artifactName": "${productName}-v${version}-Portable.exe"
    }
  }
}
